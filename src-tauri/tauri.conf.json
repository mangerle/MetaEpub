{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaEpub",
  "version": "0.1.0",
  "identifier": "com.antigravity.metaepub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MetaEpub - EPUB元数据编辑器",
        "width": 1080,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IGF1dG9tYXRpYyB1cGRhdGVyIGtleQpSV1N5T2pEQWdGSEpTbm4zUytvMStzL3QvbERmdm1aOHJ1SGNuMnVydmlydkJtdStyZThkTHh2cgo=",
      "endpoints": [
        "https://github.com/mangerle/MetaEpub/releases/latest/download/latest.json"
      ]
    }
  }
}
